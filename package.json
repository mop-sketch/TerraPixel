{
  "name": "terrapixel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:balance": "vitest run tests/balance.test.ts",
    "test:all": "vitest run --exclude \"**/node_modules/**\"",
    "harness": "tsx tools/harness.ts",
    "balance": "tsx tools/harness.ts --matrix",
    "build:single": "vite build && node tools/inline.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true,
    "esbuild@0.25.12": true
  }
}
